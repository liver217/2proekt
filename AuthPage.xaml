<Page x:Class="_2проект_.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2проект_"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Логин" Grid.Row="0" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" 
                   FontSize="20" Margin="20"/>
        <TextBox Name="LoginTB" Grid.Row="0" Grid.Column="1" 
                 Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16"/>
        <TextBlock Text="Пароль" Grid.Row="1" Grid.Column="0" 
                   HorizontalAlignment="Right" VerticalAlignment="Center" 
                   FontSize="20" Margin="20"/>
        <TextBox Name="PassTB" Grid.Row="1" Grid.Column="1" 
                     Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16"/>
        <Button Name="GuestBtn" Content="Войти как гость" Grid.Row="2" Grid.Column="0" 
                Width="150" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Click="GuestBtn_Click"/>

        <Button Name="LoginBtn" Content="Войти" Grid.Row="2" Grid.Column="1" 
                Width="200" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Click="LoginBtn_Click"/>




        <StackPanel Name="CaptchaPanel" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,10,0,10">
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
                <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
                <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
                <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
            </StackPanel>

            <TextBox Name="CaptchaTB" Width="100" Height="30" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <Button Name="RefreshBtn" Content="Обновить" Click="RefreshBtn_Click" Margin="10,0,0,0" Height="30" VerticalAlignment="Center" FontSize="14"/>
        </StackPanel>


    </Grid>
</Page>