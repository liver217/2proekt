<Window x:Class="_2проект_.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OrderWindow" Height="600" Width="850" FontFamily="Comic Sans MS"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Дата формирования заказа -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,5">
            <TextBlock Text="Дата формирования заказа" Width="200" VerticalAlignment="Center"/>
            <DatePicker Name="OrderDP" Width="580" IsEnabled="False"/>
        </StackPanel>

        <!-- Дата доставки заказа -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5">
            <TextBlock Text="Дата доставки заказа" Width="200" VerticalAlignment="Center"/>
            <DatePicker Name="DeliveryDP" Width="580" IsEnabled="False"/>
        </StackPanel>

        <!-- ФИО Клиента -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,5">
            <TextBlock Text="ФИО клиента" Width="200" VerticalAlignment="Center"/>
            <TextBlock Name="ClientTB" Width="500" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- Номер заказа -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,5">
            <TextBlock Text="Номер заказа" Width="200" VerticalAlignment="Center"/>
            <TextBlock Name="TBOrderID" Width="200" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Список товаров (как на скриншоте) -->
        <ListView Name="ShoeListView" Grid.Row="4" Margin="0,10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <!-- Картинка -->
                            <ColumnDefinition Width="*"/>
                            <!-- Информация -->
                            <ColumnDefinition Width="100"/>
                            <!-- Скидка -->
                            <ColumnDefinition Width="120"/>
                            <!-- Кнопки + / - -->
                        </Grid.ColumnDefinitions>

                        <Image Source="{Binding ProductPhotoFull}" Width="120" Height="100" Grid.Column="0" Stretch="Uniform"/>

                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductDescription}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductManufacturer}" FontSize="12"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0} рублей}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                            <TextBlock Text="Скидка" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" FontSize="30" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Кнопки управления количеством -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button Content="–" Width="30" Height="30" FontSize="18" Click="BtnMinus_Click"/>
                            <TextBlock Text="{Binding Quantity}" FontSize="18" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="+" Width="30" Height="30" FontSize="18" Click="BtnPlus_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Пункт выдачи -->
        <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0,10">
            <TextBlock Text="Пункт выдачи" Width="200" VerticalAlignment="Center"/>
            <ComboBox Name="PickupCombo" Width="580" DisplayMemberPath="PickupPointCity"/>
        </StackPanel>

        <!-- Кнопка Сохранить -->
        <Button Content="Сохранить" Grid.Row="6" Width="200" Height="40" 
                HorizontalAlignment="Center" Background="DarkOrange" Foreground="Black" FontSize="16"
                Click="SaveBtn_Click"/>
    </Grid>
</Window>
