<Page x:Class="_2проект_.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_2проект_"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ООО 41 размер"  FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left" Margin="10">
            <TextBlock Name="FIOTB" Text="ФИО" FontSize="15"  FontWeight="Bold"/>
            <TextBlock Name="RoleTB" Text="Роль" FontSize="15"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Name="TBCount" Text="0 из 0" VerticalAlignment="Center" FontSize="15" Margin="0,0,5,20"/>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="поиск по наименованию" VerticalAlignment="Center" FontSize="15" Margin="1"/>
                <TextBox Name="TBoxSearch" TextChanged="TBoxSearch_TextChanged" Width="175" FontSize="15"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,0,20,0" VerticalAlignment="Center">
                <RadioButton Name="RDButtonUp" Content="по возрастанию стоимости" GroupName="Sort" FontSize="14" Checked="RDButtonUp_Checked" Margin="1"/>
                <RadioButton Name="RDButtonDown" Content="по убыванию стоимости" GroupName="Sort" FontSize="14" Checked="RDButtonDown_Checked" Margin="1"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="фильтрация по скидке" FontSize="15" Margin="1" HorizontalAlignment="Center"/>
                <ComboBox Name="ComboType" SelectionChanged="ComboType_SelectionChanged" FontSize="15" Width="176">
                    <TextBlock>Все</TextBlock>
                    <TextBlock>от 0 до 9.99%</TextBlock>
                    <TextBlock>от 10% до 14.99%</TextBlock>
                    <TextBlock>от 15% до 100%</TextBlock>
                </ComboBox>
            </StackPanel>

        </StackPanel>
        
        
        
        <ListView Name="ServiceListView" Grid.Row="3" >
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить к заказу" Click="MenuItem_Click"></MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="800"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="175"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Image Width="250" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductPhotoFull">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductManufacturer}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat={}{0:0} рублей}" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" FontSize="16"></TextBlock>
                        <TextBlock Text="скидка" Margin="5" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" FontSize="25"></TextBlock>
                        <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" Opacity="{Binding ProductDiscountAmount}" Margin="5" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right" FontSize="40"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>




        <Button Name="OrderBtn" Content="Просмотр заказа" Visibility="Collapsed" 
                Click="OrderBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                Margin="10" Width="150" Height="40" Background="Orange" Grid.Row="4"/>

    </Grid>
</Page>
